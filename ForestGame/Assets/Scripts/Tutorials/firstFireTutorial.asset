  m_Script: {fileID: 11500000, guid: 4e88477da3f617c468bdb7ee1a7baf06, type: 3}
  m_Name: firstFireTutorial
  m_EditorClassIdentifier: Assembly-CSharp::TutorialStep
  stepId: firstFireTutorial
  title: Fires
  body: 'A fire has a small chance of starting when the weather is Normal and a bigger
    one when it is Drought or Heatwave.\n

    Use your water tool to put it out.
    If you don''t manage to do it the fire will spread to nearby tiles and damage
    the tree (-25% health).\n

    Hovering the "End Round" button will show you
    which tiles will burn down if you leave the fire. Burn down tiles are unusable
    for one round.'
  image: {fileID: 0}
